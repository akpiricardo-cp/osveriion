# ─── Supabase (Project Settings > API) ─────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-anon-publique
# Clé serveur uniquement (invitations, suspension de comptes). Ne JAMAIS l'exposer au navigateur.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role

# ─── Application ───────────────────────────────────────────────────────────
# URL publique de l'application (utilisée dans les e-mails d'invitation)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Domaine e-mail autorisé pour les comptes employés
NEXT_PUBLIC_EMAIL_DOMAIN=veriion.com
# Secret de signature du verrou « code d'accès » (32 caractères aléatoires).
# Si absent, SUPABASE_SERVICE_ROLE_KEY est utilisée. Le changer redemande le code à tout le monde.
ACCESS_CODE_SECRET=
# Préfixe des salles de visioconférence Jitsi
NEXT_PUBLIC_MEET_BASE_URL=https://meet.jit.si/veriion
NEXT_PUBLIC_TIMEZONE=Africa/Porto-Novo

# ─── Notifications par e-mail (SMTP de veriion.com : Google Workspace, Microsoft 365, Brevo…) ───
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@veriion.com
SMTP_PASSWORD=mot-de-passe-application
SMTP_FROM=VERIION OS <notifications@veriion.com>

# ─── Notifications push (téléphone, ordinateur) ───────────────────────────
# Générez la paire de clés une seule fois : npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@veriion.com

# ─── Tâches planifiées ─────────────────────────────────────────────────────
# Secret partagé avec Supabase (pg_cron + pg_net) pour appeler /api/notifications/* — 32 caractères aléatoires
CRON_SECRET=
